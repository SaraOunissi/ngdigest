{
  "name": "ngdigest-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate:blog": "node scripts/generate-blog-index.mjs",
    "generate:jobs": "node scripts/generate-jobs-data.mjs",
    "prebuild": "node scripts/generate-blog-index.mjs && node scripts/generate-jobs-data.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:jobs-links": "node scripts/check-jobs-links.mjs",
    "tag:jobs": "node scripts/tag-jobs-metadata.mjs",
    "check:tag-jobs": "node scripts/tag-jobs-metadata.mjs --check",
    "check:toolkit": "node --test \"scripts/lib/toolkit-assets.test.mjs\"",
    "check:blog-parity": "node --test \"scripts/lib/blog-parity.test.mjs\"",
    "check:style-budgets": "node scripts/check-style-budgets.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "serve:ssr:ngdigest-app": "node dist/ngdigest-app/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-server": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@angular/ssr": "^22.2.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@vercel/analytics": "^2.0.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "marked": "^17.0.5",
    "marked-highlight": "^2.2.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.18"
  }
}
