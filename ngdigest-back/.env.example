# Server
PORT=3000
CORS_ORIGIN=http://localhost:4200

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ngdigest?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=<random-256-bit-hex>
JWT_EXPIRES_IN=360d

# Aggregator
AGGREGATOR_CRON=0 */8 * * *
SERPAPI_KEY=<your-serpapi-key>
DEV_TO_ENABLED=true

# Admin endpoints (POST /api/resources/redetect-languages)
# Generate with: openssl rand -base64 24
ADMIN_SECRET=<random-secret>
