# Normalize line endings across all machines.
# Text files are stored as LF in the repo and checked out as LF everywhere,
# regardless of each contributor's core.autocrlf setting. This prevents the
# whole-tree "phantom diff" churn that CRLF↔LF mismatches otherwise produce.
* text=auto eol=lf

# Explicit text types (safety net for extensions Git might misdetect)
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.scss  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf

# Binary assets — never touch line endings or attempt diffs.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
*.pdf   binary
